{
  "name": "laberinto",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write src tests css *.js *.json *.md",
    "format:check": "prettier --check src tests css *.js *.json *.md",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
